const LOGO='<div class="tilt"><div class="rot">'+layers('rs','#2fc9b3','#0a6f6c')+'<div class="pg">'+layers('sl','#16a89a','#0a615f')+'<div class="fc f"><i></i></div><div class="fc k"><i></i></div></div></div></div>';
