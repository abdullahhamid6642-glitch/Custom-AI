.top{display:flex;justify-content:space-between;align-items:center}
.avatar,.round{width:44px;height:44px;border-radius:50%;background:var(--grad);color:#fff;display:grid;place-items:center;font-weight:600;border:0;font-size:1rem;cursor:pointer}
.pill{background:linear-gradient(135deg,#14b8a6,#0b6e6b);color:#fff;border:0;border-radius:999px;padding:11px 18px;font:inherit;font-weight:500;cursor:pointer;box-shadow:0 10px 22px rgba(11,143,138,.3)}
#hi{font-size:1.65rem;font-weight:500;line-height:1.25;margin:26px 0 20px;letter-spacing:.02em}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.card{background:var(--card);border:1px solid #fff;border-radius:22px;padding:14px;height:112px;display:flex;flex-direction:column;justify-content:space-between;text-align:left;font:inherit;cursor:pointer;box-shadow:0 8px 24px rgba(20,150,140,.12);position:relative}
.card .ic{font-size:1.6rem}
.card .ar{position:absolute;right:12px;top:12px;width:30px;height:30px;border-radius:50%;border:1px solid var(--line);display:grid;place-items:center;font-size:.8rem;background:#fff8}
.row{display:flex;justify-content:space-between;align-items:center;margin:22px 0 10px}
.row b{font-weight:500;font-size:1.05rem}.row span{font-size:.85rem;color:var(--muted)}
.chips{display:flex;gap:8px;overflow-x:auto;padding-bottom:4px;scrollbar-width:none}
.chip{flex:none;background:#fff;border:1px solid var(--line);border-radius:999px;padding:10px 14px;font:inherit;font-size:.85rem;cursor:pointer}
.composer{margin-top:auto;background:#e0f3ef;border:1px solid var(--line);border-radius:26px;padding:12px 12px 10px;display:flex;flex-direction:column;gap:6px}
.composer textarea{border:0;background:none;resize:none;font:inherit;outline:none;max-height:120px;padding:4px 6px;color:var(--ink)}
.cbar{display:flex;justify-content:space-between;align-items:center}
.sm{width:38px;height:38px;border-radius:50%;border:0;background:#fff;cursor:pointer;font-size:1rem}
.sm.go{background:var(--grad);color:#fff}
/* attachments + mic */
#chat .composer{position:relative}
.sm.mic.rec{background:#ff5c7a;color:#fff;animation:pulse 1.1s infinite}
