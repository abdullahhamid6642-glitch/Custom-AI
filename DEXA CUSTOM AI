@media(min-width:900px){
body{background:linear-gradient(160deg,#e3f7ef,#d3f0ea 60%,#d6ecf2)}
.phone{max-width:none;height:100%;margin:0;border-radius:0;box-shadow:none;background:radial-gradient(900px 500px at 85% -10%,rgba(45,212,191,.28),transparent),radial-gradient(800px 500px at -10% 110%,rgba(16,160,150,.22),transparent),linear-gradient(180deg,#fff,#effaf7)}
.screen{padding-left:max(32px,calc((100% - 820px)/2));padding-right:max(32px,calc((100% - 820px)/2));padding-top:calc(28px + env(safe-area-inset-top,0px));padding-bottom:28px}
