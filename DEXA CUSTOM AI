#splash .logo{width:280px;height:280px;margin-top:6vh;font-size:280px}
#hi{font-size:2.2rem;margin:36px 0 26px}
.grid{grid-template-columns:repeat(4,1fr);gap:16px}
.card{height:140px;transition:transform .15s,box-shadow .15s}
.card:hover,.chip:hover,.pill:hover,.btn:hover{transform:translateY(-3px);box-shadow:0 14px 30px rgba(20,150,140,.25)}
.chip{font-size:.9rem}
.m{max-width:72%;font-size:1rem}
.composer{padding:14px 16px 12px}
.composer textarea{font-size:1rem}
#log{padding:10px 4px 16px}
button{transition:transform .15s}
}
.screen{position:absolute;inset:0;display:none;flex-direction:column;padding:22px 22px 18px;padding-top:calc(22px + env(safe-area-inset-top,0px))}
.screen.on{display:flex}
.logo{position:relative;perspective:1000px;flex:none;animation:float 6s ease-in-out infinite;font-size:230px}
.logo .tilt,.logo .rot,.logo .pg{position:absolute;transform-style:preserve-3d;will-change:transform}
.logo .tilt,.logo .rot{inset:0}
.logo .pg{left:17%;top:17%;width:33%;height:66%;transform-origin:100% 50%}
.logo .fc,.logo .sl{position:absolute;inset:0;border-radius:999px 0 0 999px}
.logo .fc{backface-visibility:hidden;-webkit-backface-visibility:hidden;overflow:hidden}
.logo .fc::after{content:'';position:absolute;inset:0;border-radius:inherit;background:linear-gradient(135deg,rgba(255,255,255,.5) 0,rgba(255,255,255,.08) 38%,rgba(0,0,0,0) 55%,rgba(0,40,45,.28) 100%);pointer-events:none}
.logo .f{transform:translateZ(.0362em);background:linear-gradient(160deg,#7af5df,#14b8a6 52%,#0a6764);box-shadow:inset 3px 3px 8px rgba(255,255,255,.45),inset -3px -4px 10px rgba(0,50,55,.4)}
.logo .k{transform:translateZ(-.0362em) rotateY(180deg);background:linear-gradient(200deg,#0a6764,#14b8a6 50%,#6cf0da);box-shadow:inset 3px 3px 8px rgba(255,255,255,.4),inset -3px -4px 10px rgba(0,50,55,.4)}
.logo .f i,.logo .k i{position:absolute;right:0;top:17.5%;width:65%;height:65%;border-radius:999px 0 0 999px}
.logo .f i{background:linear-gradient(180deg,#0b7077,#093640);box-shadow:inset 6px 5px 16px rgba(0,0,0,.55),inset -2px -3px 6px rgba(120,255,235,.25)}
.logo .k i{background:linear-gradient(180deg,#d4fff4,#78e6d0);box-shadow:inset 6px 5px 16px rgba(0,90,90,.35),inset -2px -3px 6px rgba(255,255,255,.5)}
.logo .rs{position:absolute;left:50%;top:28.5%;width:21.5%;height:43%;border-radius:0 999px 999px 0}
#splash .logo::after{content:'';position:absolute;left:20%;right:20%;bottom:-11%;height:7%;border-radius:50%;background:radial-gradient(ellipse,rgba(5,70,72,.38),rgba(5,70,72,0) 70%);filter:blur(5px)}
@keyframes float{50%{transform:translateY(-10px)}}
/* splash */
#splash{align-items:center;text-align:center}
#splash .logo{width:230px;height:230px;margin:9vh 0 auto;}
#splash h1{font-size:1.7rem;margin:0 0 8px;font-weight:600}
#splash p{color:var(--muted);margin:0 0 22px;font-size:.95rem;line-height:1.45;max-width:300px}
.field{width:100%;border:1px solid var(--line);background:#fff;border-radius:999px;padding:14px 18px;font:inherit;outline:none;margin-bottom:12px;text-align:center}
.btn{width:100%;border:0;border-radius:999px;padding:16px;font:inherit;font-weight:600;font-size:1rem;color:#fff;background:var(--grad);cursor:pointer;box-shadow:0 10px 24px rgba(20,184,166,.35)}
.two{display:flex;gap:12px;width:100%}.two .btn{flex:1}
.btn.out{background:#fff;color:var(--ink);border:1.5px solid #7fe0d0;box-shadow:none}
.field{width:100%;border:1px solid var(--line);background:#fff;border-radius:999px;padding:14px 18px;font:inherit;outline:none;margin-bottom:12px;text-align:center}
.field:focus{border-color:#14b8a6;box-shadow:0 0 0 3px rgba(20,184,166,.18)}
.serr{color:#c2410c;font-size:.85rem;min-height:1.3em;margin:-4px 0 8px}
