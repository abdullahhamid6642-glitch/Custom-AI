(function(){
  const lg=$('logo'), tilt=lg.querySelector('.tilt'), rot=lg.querySelector('.rot'), pg=lg.querySelector('.pg'), sp=$('splash');
  let rx=0, ry=0, trx=0, try_=0;
  let tx=null, ty=null;               // cursor position (null = idle)
  let ang=180, fold=40, tAng=180, tFold=40, idle=0;
  const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
  const sstep=x=>{x=clamp(x,0,1);return x*x*(3-2*x)};
  const move=e=>{tx=e.clientX;ty=e.clientY};
  document.addEventListener('pointermove',move,{passive:true});
  document.addEventListener('pointerdown',move,{passive:true});
  document.documentElement.addEventListener('mouseleave',()=>{tx=null});
  function frame(){
    if(sp.classList.contains('on')){
      const r=lg.getBoundingClientRect(), cx=r.left+r.width/2, cy=r.top+r.height/2;
      if(tx==null){                    // idle: gentle orbit
        idle+=0.012; tAng=(tAng+0.9)%360; tFold=100+70*Math.sin(idle*2); trx=18*Math.sin(idle*1.3); try_=24*Math.cos(idle*1.7);
      }else{
        const dx=tx-cx, dy=ty-cy, d=Math.hypot(dx,dy);
        tAng=Math.atan2(dy,dx)*180/Math.PI;           // page folds toward the cursor
        tFold=172-147*sstep((d-r.width*0.25)/(r.width*2.2));
        trx=-clamp(dy/(innerHeight/2),-1,1)*26; try_=clamp(dx/(innerWidth/2),-1,1)*30;
      }
      let diff=((tAng-ang+540)%360)-180;
      ang+=diff*0.11; fold+=(tFold-fold)*0.09;
      rx+=(trx-rx)*0.08; ry+=(try_-ry)*0.08;
      tilt.style.transform='rotateX('+rx.toFixed(2)+'deg) rotateY('+ry.toFixed(2)+'deg)';
      rot.style.transform='rotateZ('+ang.toFixed(2)+'deg)';
      pg.style.transform='rotateY('+clamp(fold,0,172).toFixed(2)+'deg)';
      const em=lg.querySelector('.lemo'); if(em&&document.body.classList.contains('emoLogo')) em.style.transform='rotateX('+rx.toFixed(2)+'deg) rotateY('+ry.toFixed(2)+'deg) translate('+(ry*.9).toFixed(1)+'px,'+(-rx*.9).toFixed(1)+'px)';
    }
    requestAnimationFrame(frame);
  }
  frame();
})();
