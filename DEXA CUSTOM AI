.att span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.att .x{position:absolute;top:-6px;right:-6px;width:20px;height:20px;border-radius:50%;border:0;background:#333;color:#fff;font-size:.7rem;cursor:pointer;line-height:20px;padding:0}
.plusmenu{position:absolute;left:12px;bottom:62px;background:#fff;border:1px solid var(--line);border-radius:18px;padding:6px;box-shadow:0 14px 34px rgba(20,140,130,.25);display:none;flex-direction:column;min-width:170px;z-index:5}
.plusmenu.on{display:flex}
.plusmenu button{border:0;background:none;font:inherit;text-align:left;padding:11px 14px;border-radius:12px;cursor:pointer;display:flex;gap:10px;align-items:center}
.plusmenu button:hover{background:#e8f8f4}
.m .mi{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:6px}
.m .mi img{max-width:180px;max-height:160px;border-radius:12px}
.m .mi i{font-style:normal;background:rgba(255,255,255,.25);border-radius:10px;padding:4px 9px;font-size:.8rem}
#camwrap{position:fixed;inset:0;background:rgba(6,25,25,.82);display:none;align-items:center;justify-content:center;z-index:50;padding:16px}
#camwrap.on{display:flex}
.campanel{background:#0f1f1f;border-radius:24px;padding:14px;max-width:760px;width:100%;display:flex;flex-direction:column;gap:12px;align-items:center}
.campanel video{width:100%;max-height:68vh;border-radius:16px;background:#000;object-fit:contain}
.camrow{display:flex;gap:14px;align-items:center}
.shutter{width:68px;height:68px;border-radius:50%;border:4px solid #fff;background:var(--grad);cursor:pointer;padding:0}
.camrow .sm{width:46px;height:46px}
/* chat */
#chat .head{display:flex;align-items:center;gap:10px;margin-bottom:8px}
#chat .head .logo{width:40px;height:40px;font-size:40px;animation:none}
#chat .head b{flex:1;font-weight:600}
#log{flex:1;overflow-y:auto;display:flex;flex-direction:column;gap:10px;padding:6px 2px 12px}
.m{max-width:86%;padding:11px 15px;border-radius:20px;white-space:pre-wrap;word-wrap:break-word;line-height:1.5;font-size:.95rem}
.u{align-self:flex-end;background:var(--grad);color:#fff;border-bottom-right-radius:6px}
.a{align-self:flex-start;background:#fff;border:1px solid var(--line);border-bottom-left-radius:6px}
.e{align-self:center;color:#c2410c;font-size:.85rem;text-align:center}
/* settings */
#sheet{position:absolute;inset:0;background:rgba(8,40,40,.35);display:none;align-items:flex-end;z-index:5}
#sheet.on{display:flex}
.panel{background:#fff;width:100%;border-radius:28px 28px 0 0;padding:22px;padding-bottom:calc(22px + env(safe-area-inset-bottom,0px))}
.panel h3{margin:0 0 6px}.panel p{color:var(--muted);font-size:.85rem;margin:0 0 14px;line-height:1.45}
.panel .field{text-align:left;border-radius:16px}
/* ===== custom AI studio ===== */
html{font-size:var(--fs,100%)}
body{font-family:var(--font,'Inter',system-ui,sans-serif);background:var(--bg)!important}
.phone{background:linear-gradient(180deg,var(--surf),var(--bg))!important}
@media(min-width:900px){.phone{background:radial-gradient(900px 500px at 85% -10%,color-mix(in srgb,var(--a1) 30%,transparent),transparent),radial-gradient(800px 500px at -10% 110%,color-mix(in srgb,var(--a2) 22%,transparent),transparent),linear-gradient(180deg,var(--surf),var(--bg))!important}}
.a,.chip,.att,.field,.panel,.plusmenu,.sm,.card .ar,.btn.out{background:var(--surf);color:var(--ink)}
.plusmenu button,.card{color:var(--ink)}
.btn.out{border-color:var(--a1)}
.composer{background:color-mix(in srgb,var(--a1) 16%,var(--surf))}
.m,.card{border-radius:var(--rad)}
.card{backdrop-filter:blur(var(--blur));-webkit-backdrop-filter:blur(var(--blur))}
.pill{background:var(--grad)}
.u,.btn:not(.out),.sm.go,.avatar,.pill,.chip.on{color:var(--onacc)}
.sm.go,.chip.on,.btn:not(.out){background:var(--grad)}
.btn:not(.out){box-shadow:0 10px 24px color-mix(in srgb,var(--a1) 35%,transparent)}
.logo{filter:hue-rotate(var(--hue,0deg)) saturate(var(--sat,1))}
body.noanim .logo{animation:none}
.lemo{display:none}
body.emoLogo .lemo{display:grid;place-items:center;position:absolute;inset:0;font-size:.55em;line-height:1}
body.emoLogo .logo .tilt{display:none}body.emoLogo .logo{filter:none}body.nologo .logo{display:none}
#studio .top2{display:flex;align-items:center;gap:10px;margin-bottom:10px}#studio .top2 b{flex:1;font-weight:600}
#studio .prof{display:flex;gap:6px;margin-bottom:10px}
#studio select,.fl input[type=text],.fl input[type=password],.fl input[type=number],.fl textarea,.fl select{width:100%;border:1px solid var(--line);background:var(--surf);color:var(--ink);border-radius:14px;padding:11px 14px;font:inherit;outline:none}
#studio .prof select{flex:1}
#tabs{margin-bottom:8px;flex:none}
#sbody{flex:1;overflow-y:auto;padding:6px 2px 30px}
.fl{margin:0 0 13px}.fl label{display:block;font-size:.8rem;color:var(--muted);margin:0 0 5px}
.fl input[type=color]{width:100%;height:42px;border:1px solid var(--line);border-radius:14px;background:var(--surf);padding:3px}
.fl input[type=range]{width:100%;accent-color:var(--a2)}
.fl.c{display:flex;align-items:center;gap:10px}.fl.c label{margin:0}
.cr{display:grid;grid-template-columns:62px 1fr 40px;gap:6px;margin-bottom:6px}
.cr input{text-align:center}.cr input:nth-child(2){text-align:left}
#sbody .btn{margin-bottom:10px}
.savebar{flex:none;display:flex;align-items:center;gap:8px;padding:10px 0 4px;border-top:1px solid var(--line)}.savebar span{flex:1;font-size:.8rem;color:var(--muted)}.savebar .btn{width:auto;padding:12px 18px;margin:0!important}.savebar .btn:disabled{opacity:.45;cursor:default;box-shadow:none}.savebar.dirty span{color:#c2410c;font-weight:500}
.lemo{will-change:transform;pointer-events:none}.lemo img{width:78%;height:78%;object-fit:cover;border-radius:50%}
</style>
</head>
<body>
<div class="phone">
  <section class="screen on" id="splash">
    <div class="logo" id="logo"></div>
    <h1>Dexa</h1>
    <p>A smart companion that gets you, explains things simply, and helps you learn, build and create.</p>
    <input class="field" id="nm" placeholder="What's your name?" autocomplete="given-name" maxlength="30">
    <input class="field" id="ag" type="number" inputmode="numeric" min="5" max="99" placeholder="How old are you?">
    <div class="serr" id="serr"></div>
    <button class="btn" id="start">Continue</button>
  </section>

  <section class="screen" id="home">
    <div class="top"><button class="avatar" id="av" aria-label="Edit profile">H</button><span style="display:flex;gap:8px"><button class="pill" id="cust">🎨 Customize</button><button class="pill" id="key">⚙ API key</button></span></div>
    <div id="hi"></div>
    <div class="grid" id="grid"></div>
    <div class="row"><b>Chat history</b><span id="clr">Clear</span></div>
    <div class="chips" id="hist"></div>
    <div class="composer">
      <textarea id="hbox" rows="2" placeholder="Ask anything…"></textarea>
      <div class="cbar"><button class="sm" type="button" id="hnew">＋</button><span><button class="sm" type="button" id="hmic">🎙</button> <button class="sm go" type="button" id="hgo">➤</button></span></div>
    </div>
  </section>

  <section class="screen" id="chat">
    <div class="head"><button class="sm" id="back">←</button><div class="logo"></div><b id="cname">Dexa</b></div>
    <div id="log"></div>
    <div class="composer">
      <div class="atts" id="atts"></div>
      <textarea id="cbox" rows="1" placeholder="Say anything…"></textarea>
      <div class="cbar"><button class="sm" type="button" id="cplus" aria-label="Add">＋</button><span><button class="sm mic" type="button" id="cmic" aria-label="Voice input">🎙</button> <button class="sm go" type="button" id="cgo" aria-label="Send">➤</button></span></div>
      <div class="plusmenu" id="pmenu">
        <button type="button" id="pcam">📷 Camera</button>
        <button type="button" id="ppho">🖼️ Photos</button>
        <button type="button" id="pfil">📎 Files</button>
      </div>
      <input type="file" id="fcam" accept="image/*" capture="environment" hidden>
      <input type="file" id="fpho" accept="image/*" multiple hidden>
      <input type="file" id="ffil" multiple hidden>
    </div>
  </section>

  <section class="screen" id="studio">
    <div class="top2"><button class="sm" id="sback" aria-label="Back">←</button><b>Customize your AI</b></div>
    <div class="prof"><select id="psel"></select><button class="sm" id="pnew" title="New AI">＋</button><button class="sm" id="pdup" title="Duplicate">⧉</button><button class="sm" id="pdel" title="Delete">🗑</button></div>
    <div class="chips" id="tabs"></div>
    <div id="sbody"></div>
    <div class="savebar" id="sbar"><span id="sstat">All changes saved</span><button class="btn out" id="sdisc" type="button">Discard</button><button class="btn" id="ssave" type="button">Save changes</button></div>
  </section>

  <div id="camwrap"><div class="campanel">
    <video id="camv" autoplay playsinline muted></video>
    <div class="camrow"><button class="sm" type="button" id="camx" aria-label="Close">✕</button><button class="shutter" type="button" id="camsnap" aria-label="Take photo"></button><button class="sm" type="button" id="camflip" aria-label="Switch camera">🔄</button></div>
  </div></div>

  <div id="sheet"><div class="panel">
    <h3>API key</h3>
    <input class="field" id="k" type="password" placeholder="API key">
    <input class="field" id="mdl" placeholder="Model (optional, leave empty for default)">
    <button class="btn" id="ksave">Save</button>
  </div></div>
</div>
<script>
const $ = id => document.getElementById(id);
const PERSONA = `You are Dexa, a sharp, friendly, emotionally intelligent personal companion for a young man. Be warm, direct, smart and naturally expressive, like a good friend who happens to know a lot; never robotic or overly formal. Understand the emotion behind his words. When he shares something personal, listen first, acknowledge feelings without judging, never minimize problems, offer honest perspective, no unrealistic promises, respect his independence, never encourage dependency on you. Never force positivity. Be excellent at education, science, maths, tech, coding, gaming, fitness basics, writing, research, decisions, planning and creativity (stories, poems, captions, image-generation prompts, journaling, project ideas). Explain complicated things simply and accurately. Never invent facts; admit uncertainty. Match length to the moment. No generic intros or conclusions. Emojis sparingly. Write plain text without markdown symbols. Never pretend to remember things you were not told or claim actions you did not perform. If he writes in Hinglish or Urdu or another language, reply in that language.`;
const CARDS = [['🖼️','Image Prompt','Help me write a beautiful, detailed image-generation prompt. Ask me what I imagine.'],['✉️','Write a Gmail','Help me write a clear, professional Gmail. Ask me who it is for, what it is about and the tone I want. Then give me a Subject line and the full email body, ready to copy into Gmail.'],['🗓️','Plan My Day','Help me plan my day calmly. Ask me what I need to get done.'],['📝','Create a Summary','Help me create a summary. Ask me to paste or attach the text, article, notes or document, then give me a short, clear summary with the key points.']];
const ls = {get:(k,d)=>{try{const v=localStorage.getItem(k);return v==null?d:JSON.parse(v)}catch(e){return d}},set:(k,v)=>{try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}}};
/* ===== custom AI studio ===== */
