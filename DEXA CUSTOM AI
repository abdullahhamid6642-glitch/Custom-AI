let pend=[];
const LIMIT=30000;
function loadLib(u){return new Promise((ok,no)=>{const sc=document.createElement('script');sc.src=u;sc.onload=ok;sc.onerror=()=>no(new Error('lib'));document.head.appendChild(sc)})}
async function getPdfJs(){
  if(!window.pdfjsLib){
    const base='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/';
    await loadLib(base+'pdf.min.js');
    let w=base+'pdf.worker.min.js';
    try{const t=await (await fetch(w)).text(); w=URL.createObjectURL(new Blob([t],{type:'text/javascript'}))}catch(e){}
    pdfjsLib.GlobalWorkerOptions.workerSrc=w;
  }
  return pdfjsLib;
}
async function readPdf(f){
  const lib=await getPdfJs(); const doc=await lib.getDocument({data:await f.arrayBuffer()}).promise;
  let txt='', cut=false;
  for(let i=1;i<=doc.numPages;i++){
    const pg=await doc.getPage(i); const c=await pg.getTextContent();
    txt+='\n'+c.items.map(x=>x.str).join(' ');
    if(txt.length>LIMIT){cut=true;break}
  }
  if(txt.replace(/\s/g,'').length>=40) return [{name:f.name,text:txt.trim().slice(0,LIMIT)+(cut||doc.numPages>0&&txt.length>LIMIT?'\n[...document truncated]':'')}];
  // scanned PDF: no text layer, send first pages as images
  const out=[]; const n=Math.min(3,doc.numPages);
  for(let i=1;i<=n;i++){
    const pg=await doc.getPage(i); const vp0=pg.getViewport({scale:1}); const sc=Math.min(2,1280/Math.max(vp0.width,vp0.height)*1.0+0.5);
    const vp=pg.getViewport({scale:sc}); const c=document.createElement('canvas'); c.width=Math.round(vp.width); c.height=Math.round(vp.height);
    await pg.render({canvasContext:c.getContext('2d'),viewport:vp}).promise;
    out.push({img:true,name:f.name+' p'+i,mime:'image/jpeg',url:c.toDataURL('image/jpeg',0.85)});
  }
  if(doc.numPages>3) alert('This PDF is scanned (image only). Only the first 3 pages were attached.');
  return out;
}
async function readDocx(f){
  if(!window.mammoth) await loadLib('https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js');
  const r=await mammoth.extractRawText({arrayBuffer:await f.arrayBuffer()});
  const t=r.value||''; return t.length>LIMIT?t.slice(0,LIMIT)+'\n[...document truncated]':t;
}
function drawAtts(){const w=$('atts');w.innerHTML='';pend.forEach((a,i)=>{const d=document.createElement('div');d.className='att';if(a.img){const im=document.createElement('img');im.src=a.url;d.appendChild(im)}else{d.innerHTML='<span></span>';d.firstChild.textContent='📎 '+a.name}const x=document.createElement('button');x.className='x';x.textContent='✕';x.onclick=()=>{pend.splice(i,1);drawAtts()};d.appendChild(x);w.appendChild(d)})}
function readURL(f){return new Promise((ok,no)=>{const r=new FileReader();r.onload=()=>ok(r.result);r.onerror=no;r.readAsDataURL(f)})}
function shrink(url){return new Promise(ok=>{const im=new Image();im.onload=()=>{const m=1280,k=Math.min(1,m/Math.max(im.width,im.height));const c=document.createElement('canvas');c.width=Math.round(im.width*k);c.height=Math.round(im.height*k);c.getContext('2d').drawImage(im,0,0,c.width,c.height);ok(c.toDataURL('image/jpeg',0.85))};im.onerror=()=>ok(url);im.src=url})}
async function addFiles(list){
  for(const f of list){
    if(pend.length>=6){alert('Up to 6 attachments at a time.');break}
    try{
      if(f.type.startsWith('image/')){pend.push({img:true,name:f.name,mime:'image/jpeg',url:await shrink(await readURL(f))})}
      else if(f.type==='application/pdf'||/\.pdf$/i.test(f.name)){
        if(f.size>25e6){alert(f.name+' is too large (max 25 MB).');continue}
        const bar=$('cbox').placeholder; $('cbox').placeholder='Reading '+f.name+'…';
        try{ (await readPdf(f)).forEach(x=>{if(pend.length<6)pend.push(x)}) }
        catch(e){ if(f.size<15e6) pend.push({pdf:true,name:f.name,mime:'application/pdf',url:await readURL(f)}); else alert('Could not read '+f.name) }
        $('cbox').placeholder=bar;
      }
      else if(/\.docx$/i.test(f.name)){
        const bar=$('cbox').placeholder; $('cbox').placeholder='Reading '+f.name+'…';
        try{ const t=await readDocx(f); if(!t.trim()) alert(f.name+' seems to have no readable text.'); else pend.push({name:f.name,text:t}) }
        catch(e){ alert('Could not read '+f.name+'. Check your internet connection and try again.') }
        $('cbox').placeholder=bar;
      }
      else if(/\.doc$/i.test(f.name)){alert(f.name+' is an old .doc file. Please save it as .docx (or PDF) in Word and attach that.')}
      else if(f.type.startsWith('text/')||TEXTEXT.test(f.name)){pend.push({name:f.name,text:(await f.text()).slice(0,LIMIT)})}
      else alert(f.name+': this file type is not supported yet. Try an image, PDF or text file.');
    }catch(e){alert('Could not read '+f.name)}
  }
  drawAtts();
}
